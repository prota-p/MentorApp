@page "/topics"
@rendermode InteractiveServer
@attribute [Authorize]

<PageTitle>トピック一覧</PageTitle>

<InteractiveLoader>
    <div class="container-fluid mt-3">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h1>トピック一覧</h1>
        </div>

        <div class="card">
            <div class="card-body p-0">
                <TopicList AllowAdd="true" />
            </div>
        </div>
    </div>
</InteractiveLoader>
