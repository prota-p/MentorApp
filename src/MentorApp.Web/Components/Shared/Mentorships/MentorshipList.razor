@inject IMentorshipQueryService MentorshipQuery
@inject MentorshipService MentorshipService
@inject ICurrentUserService AuthService
@inject NavigationManager Navigation
@inject ToastService ToastService

@* メンタリング一覧の共通コンポーネント *@

@if (isLoading)
{
    <LoadingSpinner />
}
else if (IsEmpty)
{
    <div class="alert alert-info mb-0" role="alert">
        ℹ️ メンタリング関係がありません。
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-light">
                <tr>
                    @if (ShowMentorColumn) { <th scope="col">メンター</th> }
                    @if (ShowMenteeColumn) { <th scope="col">メンティー</th> }
                    <th scope="col">ステータス</th>
                    <th scope="col">開始日</th>
                    @if (ShouldShowStatusChangeColumn) { <th scope="col" style="width: 180px;">操作</th> }
                </tr>
            </thead>
            <tbody>
                @foreach (var mentorship in mentorships!)
                {
                    <tr role="button" @onclick="() => NavigateToDetail(mentorship.Id)" style="cursor: pointer;">
                        @if (ShowMentorColumn) { <td>@mentorship.MentorDisplayName</td> }
                        @if (ShowMenteeColumn) { <td>@mentorship.MenteeDisplayName</td> }
                        <td>
                            <MentorshipStatusBadge Status="mentorship.Status" />
                        </td>
                        <td>
                            <small class="text-muted">@mentorship.StartedAt.FormatDate()</small>
                        </td>
                        @if (ShouldShowStatusChangeColumn)
                        {
                            <td @onclick:stopPropagation="true">
                                @if (mentorship.Status == MentorshipStatus.Active)
                                {
                                    <button class="btn btn-sm btn-outline-success me-1" 
                                            @onclick="() => CompleteAsync(mentorship.Id)"
                                            disabled="@isProcessing">
                                        ✅ 完了
                                    </button>
                                    <button class="btn btn-sm btn-outline-danger" 
                                            @onclick="() => CancelAsync(mentorship.Id)"
                                            disabled="@isProcessing">
                                        ❌ 中止
                                    </button>
                                }
                                else if (mentorship.EndedAt.HasValue)
                                {
                                    <small class="text-muted">@mentorship.EndedAt.Value.FormatDate()</small>
                                }
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (ShouldShowAddButton)
{
    <div class="mt-3">
        @if (!showAddForm)
        {
            <button class="btn btn-sm btn-outline-primary" @onclick="() => showAddForm = true">
                ➕ メンタリング関係を追加
            </button>
        }
        else
        {
            <MentorshipAddForm 
                FixedMentorId="FixedMentorId"
                FixedMenteeId="FixedMenteeId"
                OnAdded="OnMentorshipAddedAsync"
                OnCancel="() => showAddForm = false" />
        }
    </div>
}

@code {
    [Parameter] public Guid? FilterByUserId { get; set; }
    [Parameter] public Guid? FixedMentorId { get; set; }
    [Parameter] public Guid? FixedMenteeId { get; set; }
    [Parameter] public bool AllowEdit { get; set; } = true;

    private bool ShowMentorColumn => !FixedMentorId.HasValue;
    private bool ShowMenteeColumn => !FixedMenteeId.HasValue;

    private IReadOnlyList<MentorshipDto>? mentorships;
    private CurrentUser? currentUser;
    private bool isLoading = true;
    private bool isProcessing;
    private bool showAddForm;

    private bool IsEmpty => mentorships is null || mentorships.Count == 0;
    private bool ShouldShowAddButton => AllowEdit && currentUser?.Role == Role.Admin;
    private bool ShouldShowStatusChangeColumn => AllowEdit && currentUser?.Role == Role.Admin;

    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    private async Task LoadDataAsync()
    {
        isLoading = true;

        try
        {
            currentUser = await AuthService.GetCurrentUserAsync();

            if (currentUser is not null)
            {
                mentorships = await MentorshipQuery.GetAccessibleAsync(currentUser, FilterByUserId);
            }
            else
            {
                mentorships = [];
            }
        }
        catch (Exception)
        {
            ToastService.ShowError("データの読み込みに失敗しました");
            mentorships = [];
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task OnMentorshipAddedAsync()
    {
        showAddForm = false;
        await LoadDataAsync();
    }

    private Task CompleteAsync(Guid mentorshipId) => ChangeStatusAsync(mentorshipId, "完了", async () =>
    {
        if (currentUser is null) return;
        await MentorshipService.CompleteMentorshipAsync(mentorshipId, currentUser);
    });

    private Task CancelAsync(Guid mentorshipId) => ChangeStatusAsync(mentorshipId, "中止", async () =>
    {
        if (currentUser is null) return;
        await MentorshipService.CancelMentorshipAsync(mentorshipId, currentUser);
    });

    private async Task ChangeStatusAsync(Guid mentorshipId, string action, Func<Task> operation)
    {
        isProcessing = true;

        try
        {
            await operation();
            ToastService.ShowSuccess($"メンタリングを{action}しました。");
            await LoadDataAsync();
        }
        catch (Exception)
        {
            ToastService.ShowError($"{action}処理に失敗しました");
        }
        finally
        {
            isProcessing = false;
        }
    }

    private void NavigateToDetail(Guid mentorshipId) => Navigation.NavigateTo($"/mentorships/{mentorshipId}");
}
