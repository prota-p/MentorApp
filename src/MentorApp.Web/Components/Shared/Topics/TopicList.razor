@inject ITopicQueryService TopicQuery
@inject ICurrentUserService AuthService
@inject NavigationManager Navigation
@inject ToastService ToastService

@* トピック一覧の共通コンポーネント *@

@if (isLoading)
{
    <LoadingSpinner />
}
else if (IsEmpty)
{
    <div class="alert alert-info mb-0" role="alert">
        ℹ️ トピックがありません。
    </div>
}
else
{
    <div class="list-group list-group-flush">
        @foreach (var topic in topics!)
        {
            <button type="button"
                    class="list-group-item list-group-item-action py-3"
                    @onclick="() => NavigateToDetail(topic.Id)">
                <div class="d-flex justify-content-between align-items-center">
                    <strong>@topic.Title</strong>
                    <TopicStatusBadge Status="topic.Status" />
                </div>
                <div class="mt-1">
                    @if (ShowMentorshipColumn)
                    {
                        <small class="text-muted me-3">
                            👥
                            @topic.MentorDisplayName
                            →
                            @topic.MenteeDisplayName
                        </small>
                    }
                    <small class="text-muted">
                        🕐
                        @topic.CreatedAt.FormatDateTime()
                    </small>
                </div>
            </button>
        }
    </div>

    <div class="px-3 py-2 bg-light text-muted">
        <small>全 @topics!.Count 件のトピック</small>
    </div>
}

@if (AllowAdd && currentUser?.Role != Role.Admin)
{
    <div class="mt-3">
        @if (!showAddForm)
        {
            <button class="btn btn-sm btn-outline-primary" @onclick="() => showAddForm = true">
                ➕ トピックを追加
            </button>
        }
        else
        {
            <TopicAddForm
                FixedMentorshipId="FilterByMentorshipId"
                OnCreated="OnTopicAddedAsync"
                OnCancel="() => showAddForm = false" />
        }
    </div>
}

@code {
    [Parameter] public Guid? FilterByMentorshipId { get; set; }
    [Parameter] public bool AllowAdd { get; set; }

    private IReadOnlyList<TopicListItemDto>? topics;
    private CurrentUser? currentUser;
    private bool isLoading = true;
    private bool showAddForm;

    private bool ShowMentorshipColumn => !FilterByMentorshipId.HasValue;
    private bool IsEmpty => topics is null || topics.Count == 0;

    protected override async Task OnInitializedAsync() => await LoadDataAsync();

    private async Task OnTopicAddedAsync()
    {
        showAddForm = false;
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        isLoading = true;

        try
        {
            currentUser = await AuthService.GetCurrentUserAsync();

            if (currentUser is null) { topics = []; return; }

            if (FilterByMentorshipId.HasValue)
            {
                topics = await TopicQuery.GetByMentorshipIdAsync(FilterByMentorshipId.Value, currentUser);
            }
            else
            {
                topics = await TopicQuery.GetAccessibleAsync(currentUser);
            }
        }
        catch (Exception)
        {
            ToastService.ShowError("データの読み込みに失敗しました");
            topics = [];
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NavigateToDetail(Guid topicId) =>
        Navigation.NavigateTo(string.Format(PageRoutes.TopicDetail, topicId));
}
