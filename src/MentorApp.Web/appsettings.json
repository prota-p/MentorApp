{
    "AllowedHosts": "*",
    "Persistence": {
        "Provider": "SqlServer",
        "Providers": {
            "SqlServer": {
                "ConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=MentorApp;Trusted_Connection=true;MultipleActiveResultSets=true"
            }
        }
    },
    "Authentication": {
        "Provider": "Mock"
    },
    "Serilog": {
        "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
        "MinimumLevel": {
            "Default": "Information",
            "Override": {
                "Microsoft": "Warning",
                "Microsoft.AspNetCore": "Warning",
                "Microsoft.EntityFrameworkCore": "Warning"
            }
        },
        "WriteTo": [
            { "Name": "Console" },
            {
                "Name": "File",
                "Args": {
                    "path": "logs/log-.txt",
                    "rollingInterval": "Day",
                    "retainedFileCountLimit": 7
                }
            }
        ],
        "Enrich": [ "FromLogContext" ]
    }
}
